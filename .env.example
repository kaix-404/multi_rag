# --- Vector store -------------------------------------------------------------
# Leave unset to auto-detect: tries Qdrant at QDRANT_URL, falls back to local numpy store.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=mmrag_chunks

# --- Dense / reranker backends -------------------------------------------------
# backend: auto | hash   (auto = BGE-M3 when sentence-transformers is installed, else hashing TF-IDF)
MMRAG_DENSE_BACKEND=auto
MMRAG_DENSE_MODEL=BAAI/bge-m3
MMRAG_RERANKER_MODEL=BAAI/bge-reranker-large
# set to "0" to disable the cross-encoder reranker entirely
MMRAG_ENABLE_RERANKER=1

# --- LLM / VLM (OpenAI-compatible endpoint) -------------------------------------
# The client speaks the OpenAI chat-completions protocol, so any server exposing
# POST {base}/chat/completions with Bearer auth works -- Pick ONE block below.
#
# If no key is set the system runs in offline extractive mode (no generation, no VLM captions).
#
# Option A -- local, free: Ollama (https://ollama.com). No API key required, but the
# client treats an empty key as "not configured", so set a placeholder value to enable
# the generative path. On memory-constrained hosts (small pagefile) also set the dense
# backend to "hash": BGE-M3 (~2 GB resident) cannot coexist with a resident local LLM.
# OPENAI_API_KEY=ollama-local
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:1.5b
# VLM_MODEL=qwen2.5:1.5b   # text-only; swap in a vision model (e.g. llava) for VLM captions
# MMRAG_DENSE_BACKEND=hash
#
# Option B -- Puter AI (https://puter.com): hosted, OpenAI-compatible REST endpoint.
# Create an app in the Puter developer dashboard and paste its API key below.
# NOTE: the server-side REST endpoint requires a paid plan (free accounts get HTTP 402).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.puter.com/puterai/openai/v1
LLM_MODEL=gpt-4o-mini
VLM_MODEL=gpt-4o-mini

# --- API / UI ------------------------------------------------------------------
MMRAG_API_URL=http://127.0.0.1:8000
